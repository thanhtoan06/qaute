<%@ include file="/WEB-INF/views/common/taglibs.jspf" %>
<title>Chi tiết yêu cầu</title>
<div class="qa-page-admin-ticket-detail" data-qa-view="admin-ticket-detail">
<style>
.qa-page-admin-ticket-detail { --page-accent: #c58219; --page-accent-dark: #96600f; --page-tint: #fff6e6; --page-line: #f4e4c7; min-width: 0; color: #344c67; }
.qa-page-admin-ticket-detail > .page-header, .qa-page-admin-ticket-detail > .qa-page-heading, .qa-page-admin-ticket-detail > .d-flex:has(> .page-title), .qa-page-admin-ticket-detail > .d-flex:has(> div > .page-title) { position: relative; isolation: isolate; display: flex; align-items: center; gap: 1rem; margin: 0 0 1.4rem !important; padding: clamp(1rem,2vw,1.45rem); overflow: hidden; border: 1px solid #dfe8f3; border-radius: 20px; background: radial-gradient(circle at 96% 0%, #fff6e6, transparent 34%), linear-gradient(125deg,#fff,#f7faff); box-shadow: 0 9px 26px rgba(16,48,84,.06); }
.qa-page-admin-ticket-detail > .page-header::after, .qa-page-admin-ticket-detail > .qa-page-heading::after { content: ""; position: absolute; z-index: -1; right: -42px; bottom: -88px; width: 160px; height: 160px; border: 1px solid #f4e4c7; border-radius: 50%; box-shadow: 0 0 0 18px rgba(32,107,196,.014),0 0 0 40px rgba(32,107,196,.009); pointer-events: none; }
.qa-page-admin-ticket-detail .qa-view-title { display: inline-flex; align-items: center; gap: .68rem; max-width: 100%; color: #193858; font-size: clamp(1.3rem,2vw,1.75rem); font-weight: 850; line-height: 1.3; letter-spacing: -.045em; }
.qa-page-admin-ticket-detail .qa-view-title-icon { display: inline-flex; flex: 0 0 36px; width: 36px; height: 36px; align-items: center; justify-content: center; border: 1px solid #f4e4c7; border-radius: 12px; color: #96600f; background: linear-gradient(145deg,#fff,#fff6e6); box-shadow: 0 6px 15px rgba(20,55,92,.08); }
.qa-page-admin-ticket-detail .card { position: relative; border: 1px solid #e0e9f3; border-radius: 18px; background: rgba(255,255,255,.98); box-shadow: 0 7px 22px rgba(16,48,84,.05); transition: border-color .22s ease,box-shadow .22s ease,transform .22s ease; }
.qa-page-admin-ticket-detail .card:hover { border-color: #f4e4c7; box-shadow: 0 13px 30px rgba(16,48,84,.085); }
.qa-page-admin-ticket-detail .card-header { display: flex; align-items: center; gap: .65rem; min-height: 56px; border-bottom: 1px solid #eaf0f7; border-radius: 18px 18px 0 0; background: linear-gradient(115deg,#fff,#fff6e6); }
.qa-page-admin-ticket-detail .card-title { color: #294664; font-weight: 800; letter-spacing: -.015em; }
.qa-page-admin-ticket-detail .card-body { color: #435b75; }
.qa-page-admin-ticket-detail .card-footer { border-top: 1px solid #eaf0f7; background: linear-gradient(110deg,#fbfdff,#fff6e6); }
.qa-page-admin-ticket-detail .form-label { color: #405a76; font-size: .79rem; font-weight: 750; }
.qa-page-admin-ticket-detail .form-control, .qa-page-admin-ticket-detail .form-select { min-height: 42px; border-color: #d7e3f1; border-radius: 10px; color: #2c4562; background-color: #fff; box-shadow: 0 2px 5px rgba(20,50,84,.025); transition: border-color .2s ease,box-shadow .2s ease; }
.qa-page-admin-ticket-detail textarea.form-control { min-height: 112px; line-height: 1.65; }
.qa-page-admin-ticket-detail .form-control:focus, .qa-page-admin-ticket-detail .form-select:focus { border-color: #c58219; box-shadow: 0 0 0 4px #fff6e6; }
.qa-page-admin-ticket-detail .btn { border-radius: 10px; font-weight: 650; transition: transform .18s ease,box-shadow .18s ease,background-color .18s ease; }
.qa-page-admin-ticket-detail .btn:not(:disabled):not(.btn-close):hover { transform: translateY(-1px); }
.qa-page-admin-ticket-detail .btn-primary { border-color: #c58219; background: linear-gradient(120deg,#c58219,#96600f); box-shadow: 0 5px 13px #f4e4c7; }
.qa-page-admin-ticket-detail .btn-outline-primary { border-color: #f4e4c7; color: #96600f; background: #fff; }
.qa-page-admin-ticket-detail .btn-outline-primary:hover { border-color: #c58219; color: #fff; background: linear-gradient(120deg,#c58219,#96600f); }
.qa-page-admin-ticket-detail .qa-filter-bar { gap: .9rem; padding: clamp(.95rem,1.8vw,1.25rem); border: 1px solid #dfe8f3; border-radius: 16px; background: linear-gradient(135deg,#fff,#fff6e6); box-shadow: 0 7px 20px rgba(16,48,84,.04); }
.qa-page-admin-ticket-detail .table-responsive { border: 1px solid #e3ebf5; border-radius: 14px; background: #fff; }
.qa-page-admin-ticket-detail .table { margin-bottom: 0; color: #405872; }
.qa-page-admin-ticket-detail .table thead th { color: #607892; font-size: .72rem; font-weight: 800; letter-spacing: .045em; background: linear-gradient(110deg,#fff6e6,#f8faff); border-bottom-color: #dfe8f3; }
.qa-page-admin-ticket-detail .table tbody tr { transition: background-color .18s ease; }
.qa-page-admin-ticket-detail .table tbody tr:hover { background: #fff6e6; }
.qa-page-admin-ticket-detail .alert { border-radius: 13px; box-shadow: 0 5px 15px rgba(16,48,84,.04); }
.qa-page-admin-ticket-detail .nav-tabs { gap: .25rem; border-bottom-color: #dce7f3; }
.qa-page-admin-ticket-detail .nav-tabs .nav-link { border-radius: 10px 10px 0 0; font-weight: 650; }
.qa-page-admin-ticket-detail .nav-tabs .nav-link.active { color: #96600f; box-shadow: inset 0 -2px #c58219; }
.qa-page-admin-ticket-detail .nav-pills .nav-link.active { color: #96600f; background: #fff6e6; box-shadow: inset 0 0 0 1px #f4e4c7; }
.qa-page-admin-ticket-detail .progress { overflow: hidden; border-radius: 999px; background: #e9eff6; }
.qa-page-admin-ticket-detail .progress-bar { border-radius: inherit; }
.qa-page-admin-ticket-detail [class*="timeline"], .qa-page-admin-ticket-detail [class*="activity"], .qa-page-admin-ticket-detail [class*="conversation"] { border-color: var(--page-line); }
@media (max-width: 767.98px) {
  .qa-page-admin-ticket-detail > .page-header, .qa-page-admin-ticket-detail > .qa-page-heading, .qa-page-admin-ticket-detail > .d-flex:has(> .page-title), .qa-page-admin-ticket-detail > .d-flex:has(> div > .page-title) { align-items: flex-start; padding: .95rem; }
  .qa-page-admin-ticket-detail .card { border-radius: 15px; }
  .qa-page-admin-ticket-detail .card-body { padding: 1rem; }
  .qa-page-admin-ticket-detail .table-responsive { border-radius: 11px; }
  .qa-page-admin-ticket-detail .qa-view-title-icon { flex-basis: 31px; width: 31px; height: 31px; border-radius: 10px; }
}
@media (prefers-reduced-motion: reduce) {
  .qa-page-admin-ticket-detail *, .qa-page-admin-ticket-detail *::before, .qa-page-admin-ticket-detail *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
</style>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="ticket" value="${detail.ticket()}"/>
<c:set var="student" value="${detail.student()}"/>
<!-- Tiêu đề và nút quay lại -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><a class="small text-secondary" href="${ctx}/admin/tickets">&larr; Danh sách yêu cầu</a><h2 class="page-title mb-0 qa-view-title" data-qa-page="admin-ticket-detail"><span class="qa-view-title-icon" aria-hidden="true"><i class="bi bi-ticket-detailed"></i></span><c:out value="${ticket.title()}"/></h2></div><span class="text-secondary"><c:out value="${ticket.code()}"/></span></div>
<div class="row g-3">
  <!-- Cột thông tin sinh viên -->
  <aside class="col-12 col-lg-3">
    <div class="card mb-3"><div class="card-header"><h3 class="card-title">Sinh viên</h3></div><div class="card-body"><div class="fw-semibold mb-2"><c:out value="${student.user().fullName()}"/></div><dl class="mb-0"><dt>MSSV</dt><dd><c:out value="${student.user().mssv()}"/></dd><dt>Khoa</dt><dd><c:out value="${student.facultyName()}" default="—"/></dd><dt>Lớp</dt><dd><c:out value="${student.classCode()}" default="—"/></dd><dt>Email</dt><dd><c:out value="${student.user().email()}"/></dd><dt>Điện thoại</dt><dd><c:out value="${student.phone()}" default="—"/></dd></dl></div></div>
    <!-- Yêu cầu khác của sinh viên -->
    <div class="card"><div class="card-header"><h3 class="card-title">Yêu cầu khác của sinh viên</h3></div><div class="list-group list-group-flush"><c:choose><c:when test="${empty detail.otherTickets()}"><div class="list-group-item text-secondary">Không có yêu cầu khác.</div></c:when><c:otherwise><c:forEach var="other" items="${detail.otherTickets()}"><a class="list-group-item list-group-item-action" href="${ctx}/admin/tickets/${other.id()}"><strong><c:out value="${other.code()}"/></strong><br/><c:out value="${other.title()}"/></a></c:forEach></c:otherwise></c:choose></div></div>
  </aside>
  <!-- Cột nội dung chính -->
  <main class="col-12 col-lg-6">
    <!-- Nội dung yêu cầu -->
    <div class="card mb-3"><div class="card-header"><h3 class="card-title">Nội dung yêu cầu</h3></div><div class="card-body"><div class="qa-richtext"><c:out value="${ticket.descriptionHtml()}" escapeXml="false"/></div><c:if test="${not empty detail.descriptionAttachments()}"><ul class="list-unstyled mt-3 mb-0"><c:forEach var="asset" items="${detail.descriptionAttachments()}"><li class="mb-2"><c:choose><c:when test="${fn:startsWith(asset.mimeType(), 'image/')}"><a href="${ctx}${asset.downloadUrl()}" target="_blank" rel="noopener noreferrer"><img src="${ctx}${asset.downloadUrl()}" alt="<c:out value='${asset.name()}'/>" class="img-fluid rounded border mt-2" style="max-width:100%;max-height:320px;object-fit:contain"/></a><br/><a href="${ctx}${asset.downloadUrl()}" target="_blank" rel="noopener noreferrer"><c:out value="${asset.name()}"/></a></c:when><c:otherwise><a href="${ctx}${asset.downloadUrl()}"><c:out value="${asset.name()}"/></a></c:otherwise></c:choose> <small class="text-secondary">(<c:out value="${asset.sizeBytes()}"/> byte)</small></li></c:forEach></ul></c:if><c:if test="${ticket.urgentRequested()}"><div class="alert alert-warning mt-3 mb-0">Sinh viên đề nghị gấp: <c:out value="${ticket.urgentReason()}"/></div></c:if><c:if test="${not empty ticket.resolutionNote()}"><div class="alert alert-success mt-3 mb-0">Giải pháp: <c:out value="${ticket.resolutionNote()}"/></div></c:if></div></div>
    <!-- Tab hội thoại và ghi chú nội bộ -->
    <ul class="nav nav-tabs mb-3" role="tablist"><li class="nav-item"><button class="nav-link active" type="button" data-bs-toggle="tab" data-bs-target="#admin-conversation">Hội thoại</button></li><li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#admin-notes">Ghi chú nội bộ <span class="badge bg-yellow-lt">${fn:length(detail.internalNotes())}</span></button></li></ul>
    <div class="tab-content"><div class="tab-pane fade show active" id="admin-conversation"><div class="card"><div class="card-body"><c:choose><c:when test="${empty detail.messages()}"><p class="text-secondary mb-0">Chưa có tin nhắn.</p></c:when><c:otherwise><div class="d-flex flex-column gap-3" data-tv2-pageable><c:forEach var="message" items="${detail.messages()}"><div class="border rounded p-3 ${message.senderType() eq 'SYSTEM' ? 'bg-light' : ''}"><div class="small fw-semibold"><c:out value="${message.senderName()}"/> <time class="text-secondary fw-normal" datetime="${message.createdAt()}" data-qaute-datetime><c:out value="${message.createdAt()}"/></time></div><div class="qa-richtext mt-2"><c:out value="${message.contentHtml()}" escapeXml="false"/></div><c:if test="${not empty message.attachments()}"><ul class="list-unstyled mt-2 mb-0"><c:forEach var="asset" items="${message.attachments()}"><li class="mb-2"><c:choose><c:when test="${fn:startsWith(asset.mimeType(), 'image/')}"><a href="${ctx}${asset.downloadUrl()}" target="_blank" rel="noopener noreferrer"><img src="${ctx}${asset.downloadUrl()}" alt="<c:out value='${asset.name()}'/>" class="img-fluid rounded border mt-2" style="max-width:100%;max-height:320px;object-fit:contain"/></a><br/><a href="${ctx}${asset.downloadUrl()}" target="_blank" rel="noopener noreferrer"><c:out value="${asset.name()}"/></a></c:when><c:otherwise><a href="${ctx}${asset.downloadUrl()}"><c:out value="${asset.name()}"/></a></c:otherwise></c:choose></li></c:forEach></ul></c:if></div></c:forEach></div></c:otherwise></c:choose></div></div></div>
      <div class="tab-pane fade" id="admin-notes"><div class="card border-warning"><div class="card-header bg-yellow-lt"><h3 class="card-title">Ghi chú nội bộ</h3></div><div class="card-body"><p class="text-secondary small">Chỉ Manager và Admin có quyền xem.</p><c:choose><c:when test="${empty detail.internalNotes()}"><p class="mb-0">Chưa có ghi chú.</p></c:when><c:otherwise><c:forEach var="note" items="${detail.internalNotes()}"><div class="border rounded bg-yellow-lt p-3 mb-2"><strong><c:out value="${note.authorName()}"/></strong> <time class="small text-secondary" datetime="${note.createdAt()}" data-qaute-datetime><c:out value="${note.createdAt()}"/></time><c:if test="${note.pinned()}"><span class="badge bg-yellow ms-1">Đã ghim</span></c:if><div class="qa-richtext mt-2"><c:out value="${note.contentHtml()}" escapeXml="false"/></div></div></c:forEach></c:otherwise></c:choose></div></div></div>
    </div>
  </main>
  <!-- Cột thông tin xử lý và can thiệp -->
  <aside class="col-12 col-lg-3">
    <div class="card mb-3"><div class="card-header"><h3 class="card-title">Thông tin xử lý</h3></div><div class="card-body"><dl class="mb-0"><dt>Mã</dt><dd><c:out value="${ticket.code()}"/></dd><dt>Chuyên mục</dt><dd><c:out value="${ticket.categoryPath()}"/></dd><dt>Ưu tiên</dt><dd><qa:priorityBadge priority="${ticket.priority()}"/></dd><dt>Trạng thái</dt><dd><qa:statusBadge status="${ticket.status()}"/></dd><dt>SLA</dt><dd><qa:slaBadge sla="${ticket.slaStatus()}"/></dd><dt>Hạn phản hồi</dt><dd><c:choose><c:when test="${not empty ticket.slaFirstResponseDueAt()}"><time datetime="${ticket.slaFirstResponseDueAt()}" data-qaute-datetime><c:out value="${ticket.slaFirstResponseDueAt()}"/></time></c:when><c:otherwise>—</c:otherwise></c:choose></dd><dt>Hạn giải quyết</dt><dd><c:choose><c:when test="${not empty ticket.slaResolutionDueAt()}"><time datetime="${ticket.slaResolutionDueAt()}" data-qaute-datetime><c:out value="${ticket.slaResolutionDueAt()}"/></time></c:when><c:otherwise>—</c:otherwise></c:choose></dd><dt>Người phụ trách</dt><dd><c:out value="${ticket.assigneeName()}"/></dd><dt>Tạo lúc</dt><dd><time datetime="${ticket.createdAt()}" data-qaute-datetime><c:out value="${ticket.createdAt()}"/></time></dd></dl></div></div>
    <div class="card mb-3"><div class="card-header"><h3 class="card-title">Đánh giá của sinh viên</h3></div><div class="card-body"><c:choose><c:when test="${empty detail.review()}"><p class="text-secondary mb-0">Chưa có đánh giá.</p></c:when><c:otherwise><div class="fw-semibold mb-2">${detail.review().rating()}/5 sao</div><p><c:out value="${detail.review().comment()}" default="Không có nhận xét"/></p><c:if test="${not empty detail.review().reasonCodes()}"><small>Lý do: <c:out value="${detail.review().reasonCodes()}"/></small></c:if><time class="small text-secondary" datetime="${detail.review().createdAt()}" data-qaute-datetime><c:out value="${detail.review().createdAt()}"/></time></c:otherwise></c:choose></div></div>
    <div class="card mb-3"><div class="card-header"><h3 class="card-title">Can thiệp của Admin</h3></div><div class="card-body d-flex flex-column gap-2"><c:if test="${ticket.status() eq 'NEW' or ticket.status() eq 'ASSIGNED' or ticket.status() eq 'IN_PROGRESS' or ticket.status() eq 'WAITING_STUDENT'}"><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#reassign-modal">Phân công lại</button></c:if><c:if test="${ticket.status() ne 'CLOSED' and ticket.status() ne 'CANCELLED'}"><button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#priority-modal">Đổi ưu tiên</button><button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#category-modal">Đổi chuyên mục</button><qa:confirmModal id="force-close-modal" title="Đóng bắt buộc" message="Đóng yêu cầu này và ghi lý do can thiệp?" actionUrl="${ctx}/admin/tickets/${ticket.id()}/force-close" confirmLabel="Đóng bắt buộc" requireReason="${true}"/></c:if></div></div>
    <div class="card"><div class="card-header"><h3 class="card-title">Dòng thời gian</h3></div><div class="card-body"><c:choose><c:when test="${empty detail.timeline()}"><p class="text-secondary mb-0">Chưa có sự kiện.</p></c:when><c:otherwise><ol class="ps-3 mb-0" data-tv2-pageable><c:forEach var="event" items="${detail.timeline()}"><li class="mb-2"><c:out value="${event.label()}"/><br/><time class="small text-secondary" datetime="${event.at()}" data-qaute-datetime><c:out value="${event.at()}"/></time></li></c:forEach></ol></c:otherwise></c:choose></div></div>
  </aside>
</div>
<c:if test="${ticket.status() ne 'CLOSED' and ticket.status() ne 'CANCELLED'}">
  <div class="modal modal-blur fade" id="reassign-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Phân công yêu cầu</h3><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><form method="post" action="${ctx}/admin/tickets/${ticket.id()}/reassign"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><div class="modal-body"><label class="form-label required" for="reassign-manager">Tư vấn viên</label><select class="form-select mb-3" id="reassign-manager" name="toManagerId" required><option value="">Chọn người phụ trách</option><c:forEach var="manager" items="${managers}"><option value="${manager.id}" ${ticket.assigneeId() eq manager.id ? 'disabled' : ''}><c:out value="${manager.fullName}"/></option></c:forEach></select><label class="form-label required" for="reassign-reason">Lý do</label><textarea class="form-control" id="reassign-reason" name="reason" minlength="10" maxlength="500" rows="3" required></textarea></div><div class="modal-footer"><button class="btn btn-link" type="button" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit">Xác nhận phân công</button></div></form></div></div></div>
  <div class="modal modal-blur fade" id="priority-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Đổi ưu tiên</h3><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><form method="post" action="${ctx}/admin/tickets/${ticket.id()}/priority"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><div class="modal-body"><label class="form-label required" for="new-priority">Mức ưu tiên</label><select class="form-select mb-3" id="new-priority" name="priority" required><option value="">Chọn mức ưu tiên</option><c:forEach var="item" items="${priorities}"><option value="${item}" ${ticket.priority() eq item ? 'disabled' : ''}><c:out value="${item.label}"/></option></c:forEach></select><label class="form-label required" for="priority-reason">Lý do</label><textarea class="form-control" id="priority-reason" name="reason" minlength="10" maxlength="500" rows="3" required></textarea></div><div class="modal-footer"><button class="btn btn-link" type="button" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit">Xác nhận đổi</button></div></form></div></div></div>
  <div class="modal modal-blur fade" id="category-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Đổi chuyên mục</h3><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><form method="post" action="${ctx}/admin/tickets/${ticket.id()}/category"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><div class="modal-body"><label class="form-label required" for="new-category">Chuyên mục</label><select class="form-select mb-3" id="new-category" name="newCategoryId" required><option value="">Chọn chuyên mục</option><c:forEach var="item" items="${categoryOptions}"><option value="${item.key}" ${ticket.categoryId() eq item.key ? 'disabled' : ''}><c:out value="${item.value}"/></option></c:forEach></select><label class="form-label required" for="category-reason">Lý do</label><textarea class="form-control" id="category-reason" name="reason" minlength="10" maxlength="500" rows="3" required></textarea></div><div class="modal-footer"><button class="btn btn-link" type="button" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit">Xác nhận đổi</button></div></form></div></div></div>
</c:if>
</div>
